# ============================================================
# VARIABLES D'ENVIRONNEMENT — backend HopeGestionV2
#
# DÉVELOPPEMENT LOCAL : copier en .env et remplir les valeurs
# RAILWAY (production) : Project > Variables > New Variable
#   — Railway injecte DATABASE_URL et PORT automatiquement
# ============================================================

# ──────────────────────────────────────────────
# SERVEUR
# ──────────────────────────────────────────────
NODE_ENV=production
# PORT est auto-injecté par Railway — ne pas définir manuellement en prod

# ──────────────────────────────────────────────
# BASE DE DONNÉES (PostgreSQL)
# Railway : variable auto-injectée via le plugin PostgreSQL.
# Local uniquement : décommenter et remplir les valeurs individuelles.
# ──────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname  ← auto-injecté par Railway
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=hope_gestion_db
# DB_PASSWORD=postgres123
# DB_PORT=5432

# ──────────────────────────────────────────────
# JWT / AUTH
# Générer : openssl rand -base64 48
# ──────────────────────────────────────────────
JWT_SECRET=REMPLACER_PAR_VALEUR_FORTE_MIN_32_CHARS
REFRESH_TOKEN_SECRET=REMPLACER_PAR_VALEUR_DIFFERENTE_DU_JWT_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# FRONTEND (URL Vercel)
# Mettre à jour après déploiement Vercel
# ──────────────────────────────────────────────
FRONTEND_URL=https://hopegestion.vercel.app

# ──────────────────────────────────────────────
# EMAIL (SMTP)
# Gmail : compte > Sécurité > Mots de passe d'application
# ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=contact@hopegestion.com
EMAIL_PASSWORD=votre-app-password-gmail
EMAIL_FROM="Hope Gestion" <contact@hopegestion.com>

# ──────────────────────────────────────────────
# STOCKAGE FICHIERS (DigitalOcean Spaces / S3-compatible)
# ──────────────────────────────────────────────
SPACES_KEY=votre-spaces-access-key
SPACES_SECRET=votre-spaces-secret-key
SPACES_BUCKET=hopegestion-uploads
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_REGION=fra1
SPACES_CDN_URL=https://hopegestion-uploads.fra1.cdn.digitaloceanspaces.com

# ──────────────────────────────────────────────
# GOOGLE OAUTH
# https://console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
# Authorized origins: https://hopegestion.vercel.app
# Authorized redirects: https://hopegestion.vercel.app/auth/google/callback
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

# ──────────────────────────────────────────────
# FEDAPAY (Paiements)
# Dashboard : https://fedapay.com
# ──────────────────────────────────────────────
FEDAPAY_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE
FEDAPAY_MODE=live
# Remplacer par l'URL Railway de votre backend
FEDAPAY_CALLBACK_URL=https://votre-backend.railway.app/api/webhooks/fedapay
# Remplacer par l'URL Vercel de votre frontend
FEDAPAY_RETURN_URL=https://hopegestion.vercel.app/dashboard/abonnement

# ──────────────────────────────────────────────
# TWILIO / WHATSAPP (optionnel)
# https://console.twilio.com
# ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre-auth-token-twilio
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ──────────────────────────────────────────────
# SUPER ADMIN (seed automatique au 1er démarrage)
# ──────────────────────────────────────────────
ADMIN_EMAIL=superadmin@hopegestion.com
