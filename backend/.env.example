# Configuration du Serveur
PORT=5000 
NODE_ENV=development 

# Configuration de la Base de Données PostgreSQL
# Remplacez les valeurs (user, password, etc.) par vos informations locales.
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432 
DB_NAME=hope_gestion_db

# Clés secrètes (utilisées pour l'Authentification au Jour 2)
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN=7d

# Configuration FedaPay (Paiements Mobile Money)
FEDAPAY_SECRET_KEY=sk_sandbox_change_me
FEDAPAY_PUBLIC_KEY=pk_sandbox_change_me
FEDAPAY_MODE=sandbox
FEDAPAY_CALLBACK_URL=http://localhost:5173/dashboard/abonnement
FEDAPAY_RETURN_URL=http://localhost:5000/api/webhooks/fedapay

# Configuration Email (Password Reset & Notifications)
# Pour Gmail: utiliser un "App Password" (Paramètres > Sécurité > Mots de passe des applications)
# Pour production: utiliser un service SMTP professionnel (SendGrid, Mailgun, AWS SES)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USER=contact@hopegestion.com
EMAIL_PASSWORD=change_me
EMAIL_FROM="Hope Gestion <contact@hopegestion.com>"
FRONTEND_URL=http://localhost:5173

# Configuration Google OAuth
# Obtenir sur: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

PROD_DATABASE_URL=postgresql://user:password@host:port/database
