# Environment Variables Template for Digital Ocean App Platform
# Copy these to your App Platform Environment Variables settings

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Node Environment
NODE_ENV=production
PORT=8080

# Database Configuration (PostgreSQL Managed Database)
# Get this from Digital Ocean Database → Connection Details
DATABASE_URL=postgresql://doadmin:GENERATED_PASSWORD@your-db-host.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Individual DB credentials (for fallback)
DB_USER=doadmin
DB_PASSWORD=GENERATED_PASSWORD
DB_HOST=your-db-host.db.ondigitalocean.com
DB_NAME=defaultdb
DB_PORT=25060

# JWT Secret (Generate a strong random string)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_and_secure_jwt_secret_minimum_64_characters_recommended

# Frontend URL (Will be provided by Digital Ocean after deployment)
FRONTEND_URL=https://your-app-name.ondigitalocean.app

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-app-name.ondigitalocean.app,https://www.yourdomain.com

# Digital Ocean Spaces Configuration (for file uploads)
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_BUCKET=hopegestion-uploads
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
SPACES_REGION=fra1
SPACES_CDN_URL=https://hopegestion-uploads.fra1.cdn.digitaloceanspaces.com

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@hopegestion.com

# Twilio Configuration (Optional - for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# FedaPay Configuration (Optional - for payments)
FEDAPAY_API_KEY=your_fedapay_api_key
FEDAPAY_ENVIRONMENT=live

# Session & Security
SESSION_SECRET=another_very_long_random_secret_for_sessions

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# API URL (Backend URL provided by Digital Ocean)
VITE_API_URL=https://your-backend-app.ondigitalocean.app/api

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# App Configuration
VITE_APP_NAME=HopeGestion
VITE_APP_VERSION=1.0.0
