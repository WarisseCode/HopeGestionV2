{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "paths": {
      "@hopegestion/api-client": ["../../packages/api-client/src/index.ts"],
      "@hopegestion/shared-types": ["../../packages/shared-types/src/index.ts"],
