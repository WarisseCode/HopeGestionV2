{
  "expo": {
    "name": "Hope Gestion",
    "slug": "hopegestion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hopegestion",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hopegestion.mobile"
    },
    "android": {
      "package": "com.hopegestion.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Hope Gestion a besoin d'accéder à votre caméra pour les photos d'état des lieux."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hope Gestion accède à vos photos pour les états des lieux et les documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#12D897",
          "defaultChannel": "hopegestion"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

